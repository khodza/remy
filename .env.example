# ---- Required --------------------------------------------------------------
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# OpenAI key used for parsing (gpt-4o-mini) and transcription (whisper-1)
OPENAI_API_KEY=your_openai_api_key_here
# Secret used to sign short-lived JWTs for the Mini App. At least 32 characters.
JWT_SECRET=change_me_to_a_random_32_char_string_or_longer

# Model for the chat intent router; must support structured outputs.
OPENAI_ASSISTANT_MODEL=gpt-4o-mini

# ---- Owner lock (strongly recommended) --------------------------------------
# Remy is a single-owner bot. With this set, the bot ignores every other
# Telegram user and the HTTP API rejects their initData and tokens.
# Find your id by messaging @userinfobot, or leave unset to allow anyone.
OWNER_TELEGRAM_ID=
# IANA timezone for new users and for old tasks that predate per-task
# timezones. The Mini App replaces it with the detected zone on first open.
OWNER_TIMEZONE=Asia/Tashkent

# ---- Infrastructure --------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/remy
NODE_ENV=development
PORT=3000

# Public https URL of the Mini App. When set, reminders get an "Open in app"
# button that opens the task (…?task=<id>).
MINI_APP_URL=

# ---- Logging -----------------------------------------------------------------
# pino level: fatal|error|warn|info|debug|trace|silent. Default: debug in
# development (pretty), info in production (JSON), silent in tests.
LOG_LEVEL=

# ---- HTTP API (Mini App) ---------------------------------------------------
JWT_EXPIRES_IN=15m
# Max age of Telegram initData in seconds (default 24h)
INIT_DATA_MAX_AGE_SECONDS=86400
# Comma-separated origin allowlist. Empty = any origin (dev only);
# required when NODE_ENV=production.
CORS_ORIGINS=https://web.telegram.org

# ---- Development only ------------------------------------------------------
# Accept the frontend's mocked initData (hash=dev-mock-hash) without HMAC
# verification so the Mini App runs in a plain browser (pnpm dev in
# ../remy-webapp). Refused when NODE_ENV=production. Set OWNER_TELEGRAM_ID to
# the frontend's VITE_MOCK_TG_USER_ID (default 123456789) or leave it unset.
DEV_ALLOW_MOCK_INITDATA=false
